[
  {
    "elementId": "nsu=https://acme.example/UA/Equipment/;s=EquipmentType",
    "displayName": "EquipmentType",
    "namespaceUri": "https://acme.example/UA/Equipment/",
    "sourceTypeId": "nsu=http://opcfoundation.org/UA/;s=BaseObjectType",
    "version": "1.0.0",
    "schema": {
      "$id": "nsu=https://acme.example/UA/Equipment/;s=EquipmentType",
      "type": "object",
      "title": "EquipmentType",
      "description": "Abstract base for all plant equipment",
      "x-opcua": {
        "abstract": true
      },
      "properties": {
        "Manufacturer": {
          "type": "string",
          "readOnly": true,
          "x-opcua": {
            "nodeClass": "Property"
          }
        },
        "SerialNumber": {
          "type": "string",
          "readOnly": true,
          "x-opcua": {
            "nodeClass": "Property"
          }
        },
        "State": {
          "$ref": "#/$defs/EquipmentState",
          "readOnly": true
        },
        "CycleCount": {
          "type": [
            "integer",
            "null"
          ],
          "readOnly": true
        }
      },
      "required": [
        "Manufacturer",
        "SerialNumber",
        "State"
      ],
      "$defs": {
        "EquipmentState": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4
          ],
          "x-enumNames": [
            "Idle",
            "Running",
            "Paused",
            "Fault",
            "Maintenance"
          ],
          "description": "Operational state common to all equipment"
        }
      }
    }
  },
  {
